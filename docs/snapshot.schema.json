{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bruce-BC/literature-atlas/schemas/snapshot-v1.json",
  "title": "Literature Atlas snapshot",
  "type": "object",
  "required": ["schemaVersion", "source", "status", "papers", "fields", "concepts", "memberships", "edges", "attachments", "collections", "overview", "modelStatus", "allocationMode"],
  "properties": {
    "schemaVersion": {"const": 1},
    "source": {"$ref": "#/$defs/source"},
    "status": {"$ref": "#/$defs/status"},
    "papers": {"type": "array", "items": {"$ref": "#/$defs/paper"}},
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "concepts": {"type": "array", "items": {"$ref": "#/$defs/concept"}},
    "memberships": {"type": "array", "items": {"$ref": "#/$defs/membership"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachment"}},
    "collections": {"type": "array", "items": {"$ref": "#/$defs/collection"}},
    "overview": {"$ref": "#/$defs/overview"},
    "modelStatus": {"type": "object", "additionalProperties": true},
    "allocationMode": {"enum": ["primary-display-field", "normalized-multifield"]},
    "revision": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9:_./@+%-]+$"},
    "source": {
      "type": "object", "required": ["id", "serverId", "epoch", "alias", "zoteroApi", "schema"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "serverId": {"type": "string", "minLength": 1},
        "epoch": {"type": "string", "minLength": 1}, "alias": {"type": "string"},
        "zoteroApi": {"const": "3"}, "schema": {"type": "integer", "minimum": 1}
      }, "additionalProperties": true
    },
    "status": {
      "type": "object", "required": ["phase", "stale"],
      "properties": {"phase": {"enum": ["idle", "syncing", "error", "offline"]}, "stale": {"type": "boolean"}, "lastSuccess": {"type": ["string", "null"]}, "message": {"type": ["string", "null"]}, "observedLag": {"type": ["number", "null"]}, "watcherInterval": {"type": ["number", "null"]}}, "additionalProperties": true
    },
    "label": {"type": "object", "properties": {"en": {"type": "string"}, "ko": {"type": "string"}}, "additionalProperties": true},
    "paper": {
      "type": "object", "required": ["id", "key", "libraryID", "title", "authors", "keywords", "fieldIds", "conceptIds", "attachmentIds", "textStatus"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "key": {"type": "string", "minLength": 1}, "libraryID": {"type": "integer", "minimum": 0}, "title": {"type": "string"}, "year": {"type": ["integer", "null"]}, "authors": {"type": "array", "items": {"type": "string"}}, "doi": {"type": ["string", "null"]}, "abstract": {"type": ["string", "null"]}, "keywords": {"type": "array", "items": {"type": "string"}}, "fieldIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "conceptIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "displayFieldId": {"type": ["string", "null"]}, "attachmentIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "textStatus": {"enum": ["readable", "indexed", "missing", "scan", "error", "pending"]}}, "additionalProperties": true
    },
    "field": {"type": "object", "required": ["id", "label", "parentIds", "aliases", "source"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "parentIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "aliases": {"type": "array", "items": {"type": "string"}}, "source": {"enum": ["user", "openalex", "msc", "model"]}}, "additionalProperties": true},
    "concept": {"type": "object", "required": ["id", "label", "aliases", "source"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "aliases": {"type": "array", "items": {"type": "string"}}, "source": {"enum": ["extracted", "user", "openalex"]}}, "additionalProperties": true},
    "membership": {"type": "object", "required": ["id", "paperId", "fieldId", "method", "weight"], "properties": {"id": {"$ref": "#/$defs/id"}, "paperId": {"$ref": "#/$defs/id"}, "fieldId": {"$ref": "#/$defs/id"}, "method": {"enum": ["user", "model", "openalex"]}, "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "weight": {"type": "number", "minimum": 0}, "evidenceSpan": {"type": ["string", "null"]}, "modelVersion": {"type": ["string", "null"]}}, "additionalProperties": true},
    "edge": {"type": "object", "required": ["id", "source", "target", "type", "directed", "provenance", "evidenceTier"], "properties": {"id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/id"}, "type": {"enum": ["citation", "semantic", "keyword", "field", "related"]}, "directed": {"type": "boolean"}, "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "provenance": {"type": "object", "required": ["provider", "method"], "properties": {"provider": {"type": "string"}, "method": {"type": "string"}, "modelRevision": {"type": ["string", "null"]}}, "additionalProperties": true}, "evidenceTier": {"enum": ["metadata", "indexed", "fulltext", "ocr", "unknown"]}, "verified": {"type": "boolean"}}, "additionalProperties": true},
    "attachment": {"type": "object", "required": ["id", "parentId", "name", "status"], "properties": {"id": {"$ref": "#/$defs/id"}, "parentId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "standalone": {"type": "boolean"}, "name": {"type": "string"}, "status": {"enum": ["readable", "indexed", "missing", "scan", "error"]}, "contentHash": {"type": ["string", "null"]}}, "additionalProperties": true},
    "collection": {"type": "object", "required": ["id", "label", "paperIds"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string"}, "paperIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}}, "additionalProperties": true},
    "overview": {"type": "object", "required": ["fields", "ribbons", "keywordAggregate", "totalPapers", "totalEdges"], "properties": {"fields": {"type": "array", "items": {"type": "object", "required": ["fieldId", "paperWeight"], "properties": {"fieldId": {"$ref": "#/$defs/id"}, "paperWeight": {"type": "number", "minimum": 0}}, "additionalProperties": true}}, "ribbons": {"type": "array", "items": {"type": "object", "required": ["sourceFieldId", "targetFieldId", "weight"], "properties": {"sourceFieldId": {"$ref": "#/$defs/id"}, "targetFieldId": {"$ref": "#/$defs/id"}, "weight": {"type": "number", "minimum": 0}}, "additionalProperties": true}}, "keywordAggregate": {"$ref": "#/$defs/keywordAggregate"}, "totalPapers": {"type": "integer", "minimum": 0}, "totalEdges": {"type": "integer", "minimum": 0}}, "additionalProperties": true},
    "keywordAggregate": {"type": "object", "required": ["conceptIds", "pairs", "encoding"], "properties": {"conceptIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "pairs": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}], "minItems": 3, "maxItems": 3}}, "encoding": {"const": "concept-index-pairs"}, "totalPairs": {"type": "integer", "minimum": 0}, "totalWeight": {"type": "integer", "minimum": 0}}, "additionalProperties": true}
  }
}
