{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bruce-BC/literature-atlas/schemas/snapshot-v1.json",
  "title": "Literature Atlas snapshot",
  "type": "object",
  "required": ["schemaVersion", "source", "status", "papers", "fields", "concepts", "memberships", "edges", "attachments", "collections", "overview", "modelStatus", "allocationMode"],
  "properties": {
    "schemaVersion": {"const": 1},
    "source": {"$ref": "#/$defs/source"},
    "status": {"$ref": "#/$defs/status"},
    "papers": {"type": "array", "items": {"$ref": "#/$defs/paper"}},
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "concepts": {"type": "array", "items": {"$ref": "#/$defs/concept"}},
    "memberships": {"type": "array", "items": {"$ref": "#/$defs/membership"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachment"}},
    "collections": {"type": "array", "items": {"$ref": "#/$defs/collection"}},
    "overview": {"$ref": "#/$defs/overview"},
    "modelStatus": {"type": "object", "additionalProperties": true},
    "allocationMode": {"enum": ["primary-display-field", "normalized-multifield"]},
    "revision": {"type": "integer", "minimum": 0},
    "recipe": {"type": ["string", "object"]},
    "generation": {"type": ["integer", "string"], "minimum": 0},
    "facetCatalog": {"$ref": "#/$defs/facetCatalog"},
    "paperFacets": {"type": "array", "items": {"$ref": "#/$defs/paperFacet"}},
    "conceptQualityLedger": {"$ref": "#/$defs/conceptQualityLedger"},
    "categoryColorRegistry": {"$ref": "#/$defs/categoryColorRegistry"},
    "fieldStats": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/fieldStat"}}, {"$ref": "#/$defs/fieldStats"}, {"type": "object", "patternProperties": {"^[A-Za-z0-9:_./@+%-]+$": {"$ref": "#/$defs/fieldStatValues"}}, "additionalProperties": false}]},
    "taxonomyState": {"$ref": "#/$defs/taxonomyState"},
    "taxonomyRedirects": {"type": "object", "patternProperties": {"^[A-Za-z0-9:_./@+%-]+$": {"$ref": "#/$defs/id"}}, "additionalProperties": false}
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9:_./@+%-]+$"},
    "source": {"type": "object", "required": ["id", "serverId", "epoch", "alias", "zoteroApi", "schema"], "properties": {"id": {"type": "string", "minLength": 1}, "serverId": {"type": "string", "minLength": 1}, "epoch": {"type": "string", "minLength": 1}, "alias": {"type": "string"}, "zoteroApi": {"const": "3"}, "schema": {"type": "integer", "minimum": 1}}, "additionalProperties": true},
    "status": {"type": "object", "required": ["phase", "stale"], "properties": {"phase": {"enum": ["idle", "syncing", "error", "offline"]}, "stale": {"type": "boolean"}, "lastSuccess": {"type": ["string", "null"]}, "message": {"type": ["string", "null"]}, "observedLag": {"type": ["number", "null"]}, "watcherInterval": {"type": ["number", "null"]}}, "additionalProperties": true},
    "label": {"type": "object", "properties": {"en": {"type": "string"}, "ko": {"type": "string"}}, "additionalProperties": true},
    "paper": {"type": "object", "required": ["id", "key", "libraryID", "title", "authors", "keywords", "fieldIds", "conceptIds", "attachmentIds", "textStatus"], "properties": {"id": {"$ref": "#/$defs/id"}, "key": {"type": "string", "minLength": 1}, "libraryID": {"type": "integer", "minimum": 0}, "title": {"type": "string"}, "year": {"type": ["integer", "null"]}, "authors": {"type": "array", "items": {"type": "string"}}, "doi": {"type": ["string", "null"]}, "abstract": {"type": ["string", "null"]}, "keywords": {"type": "array", "items": {"type": "string"}}, "fieldIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "conceptIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "displayFieldId": {"type": ["string", "null"]}, "attachmentIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "textStatus": {"enum": ["readable", "indexed", "missing", "scan", "error", "pending"]}}, "additionalProperties": true},
    "field": {"type": "object", "required": ["id", "label", "parentIds", "aliases", "source"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "parentIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "aliases": {"type": "array", "items": {"type": "string"}}, "source": {"enum": ["user", "openalex", "msc", "model"]}}, "additionalProperties": true},
    "concept": {"type": "object", "required": ["id", "label", "aliases", "source"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "aliases": {"type": "array", "items": {"type": "string"}}, "source": {"enum": ["extracted", "user", "openalex"]}}, "additionalProperties": true},
    "membership": {"type": "object", "required": ["id", "paperId", "fieldId", "method", "weight"], "properties": {"id": {"$ref": "#/$defs/id"}, "paperId": {"$ref": "#/$defs/id"}, "fieldId": {"$ref": "#/$defs/id"}, "method": {"enum": ["user", "model", "openalex"]}, "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "weight": {"type": "number", "minimum": 0}, "evidenceSpan": {"type": ["string", "null"]}, "modelVersion": {"type": ["string", "null"]}}, "additionalProperties": true},
    "edge": {"type": "object", "required": ["id", "source", "target", "type", "directed", "provenance", "evidenceTier"], "properties": {"id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/id"}, "type": {"enum": ["citation", "semantic", "keyword", "field", "related"]}, "directed": {"type": "boolean"}, "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "provenance": {"type": "object", "required": ["provider", "method"], "properties": {"provider": {"type": "string"}, "method": {"type": "string"}, "modelRevision": {"type": ["string", "null"]}}, "additionalProperties": true}, "evidenceTier": {"enum": ["metadata", "indexed", "fulltext", "ocr", "unknown"]}, "verified": {"type": "boolean"}}, "additionalProperties": true},
    "attachment": {"type": "object", "required": ["id", "parentId", "name", "status"], "properties": {"id": {"$ref": "#/$defs/id"}, "parentId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "standalone": {"type": "boolean"}, "name": {"type": "string"}, "status": {"enum": ["readable", "indexed", "missing", "scan", "error"]}, "contentHash": {"type": ["string", "null"]}}, "additionalProperties": true},
    "collection": {"type": "object", "required": ["id", "label", "paperIds"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string"}, "paperIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}}, "additionalProperties": true},
    "overview": {"type": "object", "required": ["fields", "ribbons", "keywordAggregate", "totalPapers", "totalEdges"], "properties": {"fields": {"type": "array", "items": {"type": "object", "required": ["fieldId", "paperWeight"], "properties": {"fieldId": {"$ref": "#/$defs/id"}, "paperWeight": {"type": "number", "minimum": 0}}, "additionalProperties": true}}, "ribbons": {"type": "array", "items": {"type": "object", "required": ["sourceFieldId", "targetFieldId", "weight"], "properties": {"sourceFieldId": {"$ref": "#/$defs/id"}, "targetFieldId": {"$ref": "#/$defs/id"}, "weight": {"type": "number", "minimum": 0}}, "additionalProperties": true}}, "keywordAggregate": {"$ref": "#/$defs/keywordAggregate"}, "totalPapers": {"type": "integer", "minimum": 0}, "totalEdges": {"type": "integer", "minimum": 0}}, "additionalProperties": true},
    "keywordAggregate": {"type": "object", "required": ["conceptIds", "pairs", "encoding"], "properties": {"conceptIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "pairs": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}], "minItems": 3, "maxItems": 3}}, "encoding": {"const": "concept-index-pairs"}, "totalPairs": {"type": "integer", "minimum": 0}, "totalWeight": {"type": "integer", "minimum": 0}}, "additionalProperties": true},
    "facetKind": {"enum": ["subject", "method", "tool", "application"]},
    "facetCatalog": {"type": "object", "required": ["version", "entities"], "properties": {"version": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^facet-catalog-v[0-9]+$"}]}, "namespace": {"type": "string", "minLength": 1}, "sourceId": {"type": "string", "minLength": 1}, "sourceEpoch": {"type": "string", "minLength": 1}, "inputState": {"enum": ["absent", "uninitialized", "intentional-empty-valid", "valid-custom", "invalid", "disabled"]}, "kinds": {"type": "array", "items": {"$ref": "#/$defs/facetKind"}}, "paperCount": {"type": "integer", "minimum": 0}, "classifier": {"type": "object", "additionalProperties": true}, "validationErrors": {"type": "array", "items": {"type": "string"}}, "entities": {"type": "array", "items": {"$ref": "#/$defs/facetEntity"}}, "inputReason": {"type": "string"}}, "additionalProperties": false},
    "facetEntity": {"type": "object", "required": ["id", "kind", "label", "broaderIds", "aliases"], "properties": {"id": {"$ref": "#/$defs/id"}, "facetId": {"$ref": "#/$defs/id"}, "key": {"type": "string", "minLength": 1}, "ontologyKey": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/facetKind"}, "label": {"anyOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/label"}]}, "broaderIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}}, "legacyFieldId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9:_./@+%-]+$"}, "origin": {"type": "string", "minLength": 1}, "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "evidenceRef": {"type": "object", "properties": {"sourceId": {"type": "string", "minLength": 1}, "sourceEpoch": {"type": "string", "minLength": 1}, "paperId": {"$ref": "#/$defs/id"}, "facetId": {"$ref": "#/$defs/id"}, "field": {"type": "string", "minLength": 1}, "evidenceSpan": {"type": ["string", "null"]}, "evidenceTier": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "span": {"type": ["string", "null"]}, "score": {"type": "number", "minimum": 0, "maximum": 1}, "origin": {"type": "string", "minLength": 1}, "ruleVersion": {"type": "string", "minLength": 1}, "spanRange": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2}, "ruleId": {"type": "string", "minLength": 1}, "families": {"type": "array", "items": {"type": "string", "minLength": 1}}, "inputHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "normalization": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "paperFacetMembership": {"type": "object", "required": ["facetId"], "properties": {"facetId": {"$ref": "#/$defs/id"}, "ontologyKey": {"$ref": "#/$defs/id"}, "entityId": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/facetKind"}, "evidenceRef": {"$ref": "#/$defs/evidenceRef"}, "scoreKind": {"type": "string", "minLength": 1}, "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "origin": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "paperFacet": {"type": "object", "required": ["paperId", "directMemberships", "primaryByFacet"], "properties": {"paperId": {"$ref": "#/$defs/id"}, "directMemberships": {"type": "array", "items": {"$ref": "#/$defs/paperFacetMembership"}}, "primaryByFacet": {"type": "object", "patternProperties": {"^(subject|method|tool|application)$": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}}, "additionalProperties": false}, "status": {"enum": ["classified", "user", "ambiguous", "abstain"]}}, "additionalProperties": false},
    "conceptQualityEntry": {"type": "object", "required": ["status"], "anyOf": [{"required": ["conceptId"]}, {"required": ["id"]}], "properties": {"conceptId": {"$ref": "#/$defs/id"}, "id": {"$ref": "#/$defs/id"}, "label": {"anyOf": [{"type": "string"}, {"$ref": "#/$defs/label"}]}, "status": {"enum": ["raw", "active", "suppressed", "protected", "user"]}, "reason": {"type": "string", "minLength": 1}, "ruleVersion": {"type": "string", "minLength": 1}, "protectedBy": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "array", "items": {"type": "string", "minLength": 1}}]}, "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}, "termhood": {"type": "number"}, "mergedInto": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "contextMergedInto": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "mergeScope": {"enum": ["global", "per-paper"]}, "contextMergedPaperCount": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "conceptQualityLedger": {"type": "object", "properties": {"version": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]}, "ruleVersion": {"type": "string", "minLength": 1}, "raw": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/id"}, {"$ref": "#/$defs/conceptQualityEntry"}]}}, "active": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/id"}, {"$ref": "#/$defs/conceptQualityEntry"}]}}, "suppressed": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/id"}, {"$ref": "#/$defs/conceptQualityEntry"}]}}, "protected": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/id"}, {"$ref": "#/$defs/conceptQualityEntry"}]}}, "user": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/id"}, {"$ref": "#/$defs/conceptQualityEntry"}]}}, "entries": {"type": "array", "items": {"$ref": "#/$defs/conceptQualityEntry"}}, "counts": {"type": "object", "properties": {"raw": {"type": "integer", "minimum": 0}, "active": {"type": "integer", "minimum": 0}, "suppressed": {"type": "integer", "minimum": 0}, "protected": {"type": "integer", "minimum": 0}, "user": {"type": "integer", "minimum": 0}, "activeInGraph": {"type": "integer", "minimum": 0}}, "additionalProperties": false}, "projected": {"type": "boolean"}}, "additionalProperties": false},
    "categoryColorRegistry": {"type": "object", "required": ["version", "namespace", "entries"], "properties": {"version": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]}, "namespace": {"type": "string", "minLength": 1}, "entries": {"type": "array", "items": {"$ref": "#/$defs/categoryColorEntry"}}}, "additionalProperties": false},
    "categoryColorEntry": {"type": "object", "required": ["categoryKey", "ontologyKey", "kind", "family", "siblingIndex", "depthVariant", "oklchByPaletteTheme", "hexByPaletteTheme", "origin"], "properties": {"categoryKey": {"$ref": "#/$defs/id"}, "ontologyKey": {"$ref": "#/$defs/id"}, "kind": {"enum": ["field", "subject", "method", "tool", "application"]}, "family": {"type": "string", "minLength": 1}, "siblingIndex": {"type": "integer", "minimum": 0}, "depthVariant": {"type": "integer", "minimum": 0}, "oklchByPaletteTheme": {"type": "object", "patternProperties": {"^(?:(?:[a-z0-9][a-z0-9_-]*):(?:light|dark)|light|dark|system)$": {"$ref": "#/$defs/oklchTheme"}}, "additionalProperties": false}, "hexByPaletteTheme": {"type": "object", "patternProperties": {"^(?:(?:[a-z0-9][a-z0-9_-]*):(?:light|dark)|light|dark|system)$": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}, "additionalProperties": false}, "origin": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "oklchTheme": {"anyOf": [{"type": "string", "pattern": "^oklch\\([^)]*\\)$"}, {"type": "object", "required": ["oklch"], "properties": {"oklch": {"type": "string", "pattern": "^oklch\\([^)]*\\)$"}, "hex": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}, "additionalProperties": false}]},
    "fieldStatValues": {"type": "object", "properties": {"fieldId": {"$ref": "#/$defs/id"}, "direct": {"type": "integer", "minimum": 0}, "inclusive": {"type": "integer", "minimum": 0}, "primary": {"type": "integer", "minimum": 0}, "unknown": {"type": "integer", "minimum": 0}, "directPaperIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "inclusivePaperIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}}, "additionalProperties": false},
    "fieldStat": {"allOf": [{"$ref": "#/$defs/fieldStatValues"}, {"type": "object", "required": ["fieldId"]}]},
    "fieldStats": {"type": "object", "properties": {"version": {"type": "string", "minLength": 1}, "paperCount": {"type": "integer", "minimum": 0}, "rows": {"type": "array", "items": {"$ref": "#/$defs/fieldStat"}}, "unknown": {"type": "integer", "minimum": 0}, "unknownPaperIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "knownPrimary": {"type": "integer", "minimum": 0}, "invariants": {"type": "object", "additionalProperties": {"type": "boolean"}}, "projected": {"type": "boolean"}}, "additionalProperties": false},
    "taxonomyState": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["absent", "uninitialized", "intentional-empty-valid", "valid-custom", "invalid", "disabled"]}, "sourceId": {"type": "string", "minLength": 1}, "sourceEpoch": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 0}, "reason": {"type": "string"}, "recovery": {"type": "string"}}, "additionalProperties": false}
  }
}
